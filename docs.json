{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mcho Systems Documentation",
  "colors": {
    "primary": "#6D2AAB",
    "light": "#C07BFF",
    "dark": "#4D1B7C"
  },
  "favicon": {
    "light": "/images/Mcho_iconlogo_B.png",
    "dark": "/images/Mcho_iconlogo_w.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/mcho.docs.black.png",
    "dark": "/images/mcho.docs.white.png",
    "href": "https://mcho.app"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mcho.app"
      }
    ],
    "primary": {
      "type": "discord",
      "href": "https://links.mcho.app/discord"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mchoapp",
      "github": "https://github.com/Mcho-Systems-Ltd",
      "discord": "https://links.mcho.app/discord",
      "website": "https://mcho.app"
    }
  },
  "fonts": {
    "family": "Sora"
  }
}
